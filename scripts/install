#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

# Encrypts the AI service keys and mail passwords that workspace owners save
secret_key=$(ynh_string_random --length=64)
ynh_app_setting_set --key=secret_key --value="$secret_key"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

chown -R "$app:$app" "$install_dir"

#=================================================
# BUILD THE APP
#=================================================
ynh_script_progression "Building $app... (this will take a few minutes)"

_rowflare_build

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration..."

ynh_config_add --template=".env" --destination="$install_dir/.env"

chmod 400 "$install_dir/.env"
chown "$app:$app" "$install_dir/.env"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Airtable-style database" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="Rowflare listening on"

#=================================================
# CREATE THE OWNER ACCOUNT
#=================================================
ynh_script_progression "Creating the owner account..."

_rowflare_create_owner

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
